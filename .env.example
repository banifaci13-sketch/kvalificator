# Сервер
# Адрес квалификатора снаружи — нужен для входа через Яндекс и ссылок
PUBLIC_URL=https://kval.soroka-marketing.ru
# Для docker compose: домен, на который Caddy выпустит HTTPS-сертификат
DOMAIN=kval.soroka-marketing.ru
PORT=3000
HOST=0.0.0.0
# true, если сервер стоит за nginx/балансировщиком (для корректных IP в лимитах запросов)
TRUST_PROXY=true
# Сайты, с которых разрешено подключать виджет (через запятую). Пусто — любые (только для разработки)
ALLOWED_ORIGINS=https://soroka-marketing.ru,https://www.soroka-marketing.ru
DB_PATH=data/kvalificator.db
LOG_LEVEL=info

# Политика обработки персональных данных (ссылка в шаге согласия)
PRIVACY_POLICY_URL=https://soroka-marketing.ru/privacy
# Квалификатор-диалог с ИИ: off — прежний сценарий с вопросами; test — новый диалог только в тестовом опросе (ссылка из админки); on — для всех посетителей
QUALIFIER_AI=test
# Сколько дней хранить брошенные диалоги (без контакта) — потом удаляются
ABANDONED_DAYS=10

# Вопросы из Google Таблицы: Файл → Поделиться → Опубликовать в интернете → CSV.
# Пусто — вопросы берутся из config/scenario.json
SCENARIO_CSV_URL=

# Админка: вход через Яндекс ID. Приложение создаётся на https://oauth.yandex.ru/client/new
# (платформа «Веб-сервисы», Redirect URI: https://ДОМЕН/admin/auth/yandex/callback,
#  доступы: «Доступ к адресу электронной почты», «Доступ к логину, имени и фамилии»)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Сотрудники с почтой на этих доменах входят без приглашения (например soroka-marketing.ru).
# Остальных добавляйте командой: npm run admin -- add почта "Имя"
ADMIN_ALLOWED_DOMAINS=
# Первый сотрудник создаётся при запуске, если в базе никого нет (пароль можно не задавать — тогда только Яндекс ID)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Уведомления менеджерам в Telegram: токен бота от @BotFather и id чата менеджеров
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
# Чат для тестовых лидов (из раздела «Тест» админки). Пусто — тестовые лиды никуда не отправляются
TELEGRAM_TEST_CHAT_ID=
# Тот же бот отвечает клиентам в личных сообщениях. false — только уведомления менеджерам
TELEGRAM_BOT_ENABLED=true
# Пусто — long polling (работает без настройки). Для webhook: https://kval.example.ru/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Имена ботов без @ — для кнопок «Продолжить в Telegram / MAX» в виджете.
# Telegram-бот определяется автоматически по токену
TELEGRAM_BOT_USERNAME=
MAX_BOT_USERNAME=

# Отправка лидов в CRM (amoCRM, Bitrix24, Make, n8n…) — JSON POST, подпись HMAC-SHA256 в x-signature
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Zoom: приложение Server-to-Server OAuth на https://marketplace.zoom.us (Develop → Build App),
# права meeting:write (создание встреч). ZOOM_USER — e-mail пользователя Zoom, на которого создаются встречи
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER=

# Яндекс Телемост (нужен Яндекс 360 для бизнеса): приложение на https://oauth.yandex.ru/client/new
# с правом telemost-api:conferences.create, токен администратора организации
TELEMOST_TOKEN=
# PUBLIC — без комнаты ожидания; ORGANIZATION — гости ждут, сотрудники входят сразу
TELEMOST_WAITING_ROOM=PUBLIC

# ИИ-помощник для презентаций. YandexGPT (Yandex Cloud): API-ключ сервисного аккаунта с ролью
# ai.languageModels.user и id каталога. Данные клиентов в запросы не передаются: только обезличенный бриф
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt/latest
# Или Claude (Anthropic). Если заданы оба — AI_PROVIDER=yandexgpt|anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_PROVIDER=
# Поиск в интернете для ассистента (Yandex Search API). Пусто — берутся ключ и каталог YandexGPT;
# сервисному аккаунту добавьте роль search-api.webSearch.user
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=
