# Сервер
PORT=3000
HOST=0.0.0.0
# true, если сервер стоит за nginx/балансировщиком (для корректных IP в лимитах запросов)
TRUST_PROXY=true
# Сайты, с которых разрешено подключать виджет (через запятую). Пусто — любые (только для разработки)
ALLOWED_ORIGINS=https://soroka-marketing.ru,https://www.soroka-marketing.ru
DB_PATH=data/kvalificator.db
LOG_LEVEL=info

# Политика обработки персональных данных (ссылка в шаге согласия)
PRIVACY_POLICY_URL=https://soroka-marketing.ru/privacy

# Вопросы из Google Таблицы: Файл → Поделиться → Опубликовать в интернете → CSV.
# Пусто — вопросы берутся из config/scenario.json
SCENARIO_CSV_URL=

# Уведомления менеджерам в Telegram: токен бота от @BotFather и id чата менеджеров
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
# Тот же бот отвечает клиентам в личных сообщениях. false — только уведомления менеджерам
TELEGRAM_BOT_ENABLED=true
# Пусто — long polling (работает без настройки). Для webhook: https://kval.example.ru/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Имена ботов без @ — для кнопок «Продолжить в Telegram / MAX» в виджете.
# Telegram-бот определяется автоматически по токену
TELEGRAM_BOT_USERNAME=
MAX_BOT_USERNAME=

# Отправка лидов в CRM (amoCRM, Bitrix24, Make, n8n…) — JSON POST, подпись HMAC-SHA256 в x-signature
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
