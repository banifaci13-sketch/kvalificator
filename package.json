{
  "name": "soroka-kvalificator",
  "version": "0.1.0",
  "private": true,
  "description": "Квалификатор лидов Soroka Marketing: виджет для сайта, ядро оценки, уведомления менеджерам",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "scenario:csv": "node scripts/scenario-to-csv.js > config/scenario-template.csv",
    "check": "node --disable-warning=ExperimentalWarning scripts/check.js",
    "admin": "node --disable-warning=ExperimentalWarning scripts/admin.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "restore-check": "node --disable-warning=ExperimentalWarning scripts/restore-check.js",
    "brand:sync": "node scripts/brand-sync.js",
    "brand:check": "node scripts/brand-sync.js --check",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench.js",
    "deck": "node --disable-warning=ExperimentalWarning scripts/deck.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "jszip": "^3.10.2",
    "pino": "^10.4.0",
    "playwright-core": "^1.56.1",
    "pptxgenjs": "^4.0.1"
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
