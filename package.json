  "private": true,
  "description": "Квалификатор лидов Soroka Marketing: виджет для сайта, ядро оценки, уведомления менеджерам",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
