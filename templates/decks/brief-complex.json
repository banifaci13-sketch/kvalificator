{
  "id": "brief-complex",
  "group": "brief",
  "name": "Бриф: первичный (комплексный маркетинг)",
  "description": "Для первой встречи: бизнес, аудитория, цели, каналы и бюджет на маркетинг.",
  "variables": [
    {
      "key": "client",
      "label": "Клиент",
      "from": "lead.company"
    },
    {
      "key": "date",
      "label": "Дата",
      "from": "today"
    },
    {
      "key": "manager",
      "label": "Менеджер",
      "from": "user.name"
    },
    {
      "key": "manager_contacts",
      "label": "Контакты менеджера",
      "from": ""
    }
  ],
  "spec": {
    "meta": {
      "title": "Бриф: первичный (комплексный маркетинг): {{client}}"
    },
    "slides": [
      {
        "type": "cover",
        "title": "Бриф: первичный (комплексный маркетинг)",
        "subtitle": "Ответы помогут понять задачу и предложить, какие каналы дадут результат быстрее.",
        "client": "{{client}}",
        "date": "{{date}}",
        "author": "Soroka Marketing"
      },
      {
        "type": "brief",
        "title": "О компании",
        "layout": "grid",
        "questions": [
          {
            "question": "Чем занимается компания?",
            "hint": "Продукт или услуга, география, сколько лет на рынке",
            "answer": ""
          },
          {
            "question": "Где вы продаёте?",
            "hint": "Сайт, соцсети, маркетплейсы, офлайн-точки — ссылки",
            "answer": ""
          },
          {
            "question": "Чем вы отличаетесь от конкурентов?",
            "hint": "Цена, сроки, гарантии, экспертиза — что важно вашему клиенту",
            "answer": ""
          },
          {
            "question": "Кто ваши главные конкуренты?",
            "hint": "2–5 компаний или сайтов",
            "answer": ""
          }
        ]
      },
      {
        "type": "brief",
        "title": "Ваш клиент",
        "layout": "grid",
        "questions": [
          {
            "question": "Кто ваш клиент?",
            "hint": "Пол, возраст, доход; B2B или B2C; кто принимает решение",
            "answer": ""
          },
          {
            "question": "География",
            "hint": "Где ваши клиенты: города, регионы, вся Россия",
            "answer": ""
          },
          {
            "question": "Есть ли сезонность?",
            "hint": "Месяцы пика и спада спроса",
            "answer": ""
          },
          {
            "question": "Средний чек и маржинальность",
            "hint": "Чтобы посчитать допустимую стоимость клиента",
            "answer": ""
          }
        ],
        "start": 5
      },
      {
        "type": "brief",
        "title": "Цели и бюджет",
        "layout": "rows",
        "questions": [
          {
            "question": "Главная цель на 3–6 месяцев",
            "hint": "Рост продаж, выход в новый регион, запуск продукта, узнаваемость",
            "answer": ""
          },
          {
            "question": "Какие каналы уже работают?",
            "hint": "Реклама, SEO, соцсети, рассылки — сколько дают заявок",
            "answer": ""
          },
          {
            "question": "Бюджет на маркетинг в месяц",
            "hint": "Общая сумма: реклама и работа подрядчиков",
            "answer": ""
          }
        ],
        "start": 9
      },
      {
        "type": "brief",
        "title": "Текущая ситуация",
        "layout": "grid",
        "questions": [
          {
            "question": "Сайт и аналитика",
            "hint": "Адрес сайта; есть ли Яндекс Метрика и цели",
            "answer": ""
          },
          {
            "question": "Как обрабатываете заявки?",
            "hint": "CRM, отдел продаж, скорость ответа",
            "answer": ""
          },
          {
            "question": "Что пробовали и не сработало?",
            "hint": "Каналы, подрядчики, причины",
            "answer": ""
          },
          {
            "question": "Кто принимает решения?",
            "hint": "Имя, должность, кто согласует бюджет",
            "answer": ""
          }
        ],
        "start": 12
      },
      {
        "type": "closing",
        "title": "Что дальше",
        "steps": [
          "Пришлите заполненный бриф или обсудим его на созвоне",
          "Подготовим стратегию продвижения и предложение по каналам",
          "Согласуем план и запустим работу"
        ],
        "contacts": {
          "name": "{{manager}}",
          "role": "Soroka Marketing",
          "phone": "{{manager_contacts}}"
        }
      }
    ]
  }
}
