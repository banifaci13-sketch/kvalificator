{
  "id": "brief-seo",
  "group": "brief",
  "name": "Бриф: SEO-продвижение",
  "description": "Сайт, ключевые запросы, конкуренты в поиске, контент и доступы.",
  "variables": [
    {
      "key": "client",
      "label": "Клиент",
      "from": "lead.company"
    },
    {
      "key": "date",
      "label": "Дата",
      "from": "today"
    },
    {
      "key": "manager",
      "label": "Менеджер",
      "from": "user.name"
    },
    {
      "key": "manager_contacts",
      "label": "Контакты менеджера",
      "from": ""
    }
  ],
  "spec": {
    "meta": {
      "title": "Бриф: SEO-продвижение: {{client}}"
    },
    "slides": [
      {
        "type": "cover",
        "title": "Бриф: SEO-продвижение",
        "subtitle": "Ответы помогут оценить сайт, собрать семантику и спрогнозировать рост трафика.",
        "client": "{{client}}",
        "date": "{{date}}",
        "author": "Soroka Marketing"
      },
      {
        "type": "brief",
        "title": "О компании",
        "layout": "grid",
        "questions": [
          {
            "question": "Чем занимается компания?",
            "hint": "Продукт или услуга, география, сколько лет на рынке",
            "answer": ""
          },
          {
            "question": "Где вы продаёте?",
            "hint": "Сайт, соцсети, маркетплейсы, офлайн-точки — ссылки",
            "answer": ""
          },
          {
            "question": "Чем вы отличаетесь от конкурентов?",
            "hint": "Цена, сроки, гарантии, экспертиза — что важно вашему клиенту",
            "answer": ""
          },
          {
            "question": "Кто ваши главные конкуренты?",
            "hint": "2–5 компаний или сайтов",
            "answer": ""
          }
        ]
      },
      {
        "type": "brief",
        "title": "Сайт",
        "layout": "grid",
        "questions": [
          {
            "question": "Адрес сайта и CMS",
            "hint": "Тильда, WordPress, 1С-Битрикс, самописный",
            "answer": ""
          },
          {
            "question": "Кто вносит изменения на сайт?",
            "hint": "Свой программист, подрядчик или агентство",
            "answer": ""
          },
          {
            "question": "Доступы к сервисам",
            "hint": "Яндекс Вебмастер, Метрика, админка сайта",
            "answer": ""
          },
          {
            "question": "Было ли резкое падение трафика?",
            "hint": "Когда, после каких изменений; санкции поисковиков",
            "answer": ""
          }
        ],
        "start": 5
      },
      {
        "type": "brief",
        "title": "Цели продвижения",
        "layout": "grid",
        "questions": [
          {
            "question": "Какой результат нужен от SEO?",
            "hint": "Трафик, заявки, позиции по ключевым запросам",
            "answer": ""
          },
          {
            "question": "Какие разделы и услуги в приоритете?",
            "hint": "Что продвигаем в первую очередь",
            "answer": ""
          },
          {
            "question": "Регионы продвижения",
            "hint": "Один город, несколько регионов или вся Россия",
            "answer": ""
          },
          {
            "question": "Бюджет и ожидания по срокам",
            "hint": "SEO даёт заметный результат через 3–6 месяцев",
            "answer": ""
          }
        ],
        "start": 9
      },
      {
        "type": "brief",
        "title": "Запросы и конкуренты",
        "layout": "rows",
        "questions": [
          {
            "question": "Как клиенты ищут ваш продукт?",
            "hint": "5–10 фраз, которые вводят в поиске",
            "answer": ""
          },
          {
            "question": "Кто обходит вас в поиске?",
            "hint": "Сайты конкурентов, которые выше вас в Яндексе",
            "answer": ""
          },
          {
            "question": "Какие запросы точно не нужны?",
            "hint": "Нецелевые услуги, регионы, «бесплатно», «своими руками»",
            "answer": ""
          }
        ],
        "start": 13
      },
      {
        "type": "brief",
        "title": "Контент",
        "layout": "grid",
        "questions": [
          {
            "question": "Кто готовит тексты для сайта?",
            "hint": "Ваш специалист, копирайтер агентства или вместе",
            "answer": ""
          },
          {
            "question": "Есть ли блог или статьи?",
            "hint": "Как часто выходят, кто пишет",
            "answer": ""
          },
          {
            "question": "Что нельзя писать на сайте?",
            "hint": "Юридические ограничения, требования бренда",
            "answer": ""
          },
          {
            "question": "Кто согласует изменения?",
            "hint": "Имя, должность, удобный способ связи",
            "answer": ""
          }
        ],
        "start": 16
      },
      {
        "type": "closing",
        "title": "Что дальше",
        "steps": [
          "Пришлите заполненный бриф или обсудим его на созвоне",
          "Проведём экспресс-аудит сайта и подготовим план продвижения",
          "Согласуем план и запустим работу"
        ],
        "contacts": {
          "name": "{{manager}}",
          "role": "Soroka Marketing",
          "phone": "{{manager_contacts}}"
        }
      }
    ]
  }
}
