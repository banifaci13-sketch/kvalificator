{
  "id": "brief-site",
  "group": "brief",
  "name": "Бриф: сайт или лендинг",
  "description": "Задача сайта, структура, контент, оформление, интеграции.",
  "variables": [
    {
      "key": "client",
      "label": "Клиент",
      "from": "lead.company"
    },
    {
      "key": "date",
      "label": "Дата",
      "from": "today"
    },
    {
      "key": "manager",
      "label": "Менеджер",
      "from": "user.name"
    },
    {
      "key": "manager_contacts",
      "label": "Контакты менеджера",
      "from": ""
    }
  ],
  "spec": {
    "meta": {
      "title": "Бриф: сайт или лендинг: {{client}}"
    },
    "slides": [
      {
        "type": "cover",
        "title": "Бриф: сайт или лендинг",
        "subtitle": "Ответы помогут предложить структуру, дизайн и оценить сроки и стоимость.",
        "client": "{{client}}",
        "date": "{{date}}",
        "author": "Soroka Marketing"
      },
      {
        "type": "brief",
        "title": "О компании",
        "layout": "grid",
        "questions": [
          {
            "question": "Чем занимается компания?",
            "hint": "Продукт или услуга, география, сколько лет на рынке",
            "answer": ""
          },
          {
            "question": "Где вы продаёте?",
            "hint": "Сайт, соцсети, маркетплейсы, офлайн-точки — ссылки",
            "answer": ""
          },
          {
            "question": "Чем вы отличаетесь от конкурентов?",
            "hint": "Цена, сроки, гарантии, экспертиза — что важно вашему клиенту",
            "answer": ""
          },
          {
            "question": "Кто ваши главные конкуренты?",
            "hint": "2–5 компаний или сайтов",
            "answer": ""
          }
        ]
      },
      {
        "type": "brief",
        "title": "Задача сайта",
        "layout": "rows",
        "questions": [
          {
            "question": "Зачем нужен сайт?",
            "hint": "Заявки с рекламы, каталог, интернет-магазин, имидж",
            "answer": ""
          },
          {
            "question": "Что должен сделать посетитель?",
            "hint": "Оставить заявку, позвонить, купить, записаться",
            "answer": ""
          },
          {
            "question": "Сроки и бюджет",
            "hint": "Когда нужен запуск и на какую сумму рассчитываете",
            "answer": ""
          }
        ],
        "start": 5
      },
      {
        "type": "brief",
        "title": "Структура и контент",
        "layout": "grid",
        "questions": [
          {
            "question": "Какие разделы нужны?",
            "hint": "Главная, услуги, каталог, цены, отзывы, контакты…",
            "answer": ""
          },
          {
            "question": "Есть ли тексты, фото и видео?",
            "hint": "Что готово, что нужно сделать нам",
            "answer": ""
          },
          {
            "question": "Сайты, которые нравятся",
            "hint": "2–3 ссылки и что именно в них нравится",
            "answer": ""
          },
          {
            "question": "Сайты, которые не нравятся",
            "hint": "Чего точно не хотите видеть",
            "answer": ""
          }
        ],
        "start": 8
      },
      {
        "type": "brief",
        "title": "Оформление и техника",
        "layout": "grid",
        "questions": [
          {
            "question": "Есть ли логотип и фирменный стиль?",
            "hint": "Брендбук, цвета, шрифты — пришлите файлы",
            "answer": ""
          },
          {
            "question": "Какой стиль ближе?",
            "hint": "Строгий, яркий, минималистичный, премиальный",
            "answer": ""
          },
          {
            "question": "Нужны ли интеграции?",
            "hint": "CRM, онлайн-оплата, калькулятор, онлайн-чат, 1С",
            "answer": ""
          },
          {
            "question": "Домен и хостинг",
            "hint": "Есть ли домен, где сейчас размещён сайт",
            "answer": ""
          }
        ],
        "start": 12
      },
      {
        "type": "closing",
        "title": "Что дальше",
        "steps": [
          "Пришлите заполненный бриф или обсудим его на созвоне",
          "Подготовим структуру сайта и коммерческое предложение",
          "Согласуем план и запустим работу"
        ],
        "contacts": {
          "name": "{{manager}}",
          "role": "Soroka Marketing",
          "phone": "{{manager_contacts}}"
        }
      }
    ]
  }
}
