  "variables": [
    {
      "key": "client",
      "label": "Клиент",
      "from": "lead.company"
    },
    {
      "key": "date",
      "label": "Дата",
      "from": "today"
    },
    {
      "key": "manager",
      "label": "Менеджер",
      "from": "user.name"
    },
    {
      "key": "manager_contacts",
      "label": "Контакты менеджера",
      "from": ""
    }
  ],
  "spec": {
    "meta": {
      "title": "Бриф: SMM и контент: {{client}}"
    },
    "slides": [
