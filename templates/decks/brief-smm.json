        "date": "{{date}}",
        "author": "Soroka Marketing"
      },
      {
        "type": "brief",
        "title": "О компании",
        "layout": "grid",
        "questions": [
          {
            "question": "Чем занимается компания?",
            "hint": "Продукт или услуга, география, сколько лет на рынке",
            "answer": ""
          },
          {
            "question": "Где вы продаёте?",
            "hint": "Сайт, соцсети, маркетплейсы, офлайн-точки — ссылки",
            "answer": ""
          },
          {
            "question": "Чем вы отличаетесь от конкурентов?",
            "hint": "Цена, сроки, гарантии, экспертиза — что важно вашему клиенту",
            "answer": ""
          },
          {
            "question": "Кто ваши главные конкуренты?",
            "hint": "2–5 компаний или сайтов",
            "answer": ""
          }
        ]
      },
      {
        "type": "brief",
        "title": "Соцсети сейчас",
        "layout": "grid",
        "questions": [
          {
            "question": "Ссылки на ваши аккаунты",
            "hint": "ВКонтакте, Telegram, Дзен, Одноклассники",
            "answer": ""
          },
          {
            "question": "Какие площадки в приоритете?",
            "hint": "Где ваша аудитория и куда готовы вкладываться",
            "answer": ""
          },
          {
            "question": "Что публикуете сейчас и как часто?",
            "hint": "Темы, форматы, частота постов",
            "answer": ""
          },
          {
            "question": "Результаты сейчас",
            "hint": "Подписчики, охваты, заявки из соцсетей",
            "answer": ""
          }
        ],
        "start": 5
      },
      {
        "type": "brief",
        "title": "Цели и аудитория",
        "layout": "rows",
        "questions": [
          {
            "question": "Зачем вам соцсети?",
            "hint": "Продажи, узнаваемость, лояльность, найм сотрудников",
            "answer": ""
          },
          {
            "question": "Для кого пишем?",
            "hint": "Кто читает: клиенты, партнёры, будущие сотрудники",
            "answer": ""
          },
          {
            "question": "Тон общения",
            "hint": "На «вы» или «ты», экспертно или дружелюбно; примеры брендов",
            "answer": ""
          }
        ],
        "start": 9
      },
      {
        "type": "brief",
        "title": "Контент и правила",
        "layout": "grid",
        "questions": [
          {
            "question": "Есть ли фото и видео?",
            "hint": "Фотобанк, съёмки, кто может сниматься",
            "answer": ""
          },
          {
            "question": "Кто отвечает на комментарии и сообщения?",
            "hint": "Вы или мы; как быстро нужно отвечать",
            "answer": ""
          },
          {
            "question": "Темы, которые нельзя затрагивать",
            "hint": "Политика, конкуренты, цены и другое",
            "answer": ""
          },
          {
            "question": "Бюджет на продвижение постов",
            "hint": "Сумма в месяц, если нужна реклама публикаций",
            "answer": ""
          }
        ],
        "start": 12
      },
      {
        "type": "closing",
        "title": "Что дальше",
        "steps": [
          "Пришлите заполненный бриф или обсудим его на созвоне",
          "Подготовим контент-стратегию и план публикаций на месяц",
          "Согласуем план и запустим работу"
        ],
        "contacts": {
          "name": "{{manager}}",
          "role": "Soroka Marketing",
          "phone": "{{manager_contacts}}"
        }
      }
    ]
  }
}
