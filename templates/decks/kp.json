{
  "id": "kp",
  "name": "Коммерческое предложение",
  "description": "Задача клиента, решение, медиаплан, стоимость и следующий шаг. Создаётся и из карточки лида.",
  "variables": [
    { "key": "client", "label": "Клиент", "from": "lead.company" },
    { "key": "service", "label": "Услуга", "from": "lead.service" },
    { "key": "task", "label": "Задача клиента", "from": "lead.task" },
    { "key": "date", "label": "Дата", "from": "today" },
    { "key": "manager", "label": "Менеджер", "from": "user.name" },
    { "key": "manager_contacts", "label": "Контакты менеджера", "from": "" }
  ],
  "spec": {
    "meta": { "title": "КП: {{client}}" },
    "slides": [
      { "type": "cover", "title": "{{service}} для {{client}}", "subtitle": "Коммерческое предложение", "client": "{{client}}", "date": "{{date}}", "author": "Soroka Marketing" },
      {
        "type": "strategy", "title": "Как мы видим задачу",
        "pillars": [
          { "title": "Задача", "text": "{{task}}" },
          { "title": "Что мешает сейчас", "text": "[заполнить: исходные показатели и ограничения]" },
          { "title": "Цель", "text": "[заполнить: измеримая цель и срок]" }
        ]
      },
      {
        "type": "strategy", "title": "Что предлагаем",
        "lead": "[заполнить: идея решения одним предложением]",
        "pillars": [
          { "title": "[заполнить: направление]", "text": "[заполнить: что делаем]", "channels": [] },
          { "title": "[заполнить: направление]", "text": "[заполнить: что делаем]", "channels": [] },
          { "title": "[заполнить: направление]", "text": "[заполнить: что делаем]", "channels": [] }
        ]
      },
      {
        "type": "mediaplan", "title": "Медиаплан на месяц",
        "rows": [{ "channel": "[заполнить: канал]", "budget": "[заполнить]" }],
        "assumptions": "[заполнить: на чём основан прогноз — нормативы агентства, данные клиента]",
        "dataStatus": "forecast", "source": "Расчёт агентства"
      },
      {
        "type": "proposal", "title": "Стоимость работ",
        "lead": "Ежемесячное ведение, рекламный бюджет оплачивается отдельно",
        "items": [{ "name": "{{service}}", "description": "[заполнить: что входит]", "price": "[заполнить]" }],
        "priceUnit": "в месяц",
        "terms": ["[заполнить: срок запуска]", "[заполнить: минимальный срок договора]", "Отчёт каждую неделю"],
        "validUntil": "[заполнить: дата]"
      },
      {
        "type": "closing", "title": "Следующий шаг",
        "steps": ["Обсудить предложение и бюджет", "Подписать договор и выдать доступы", "Запуск по согласованному плану"],
        "contacts": { "name": "{{manager}}", "role": "Soroka Marketing", "phone": "{{manager_contacts}}" }
      }
    ]
  }
}
